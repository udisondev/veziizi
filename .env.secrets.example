# Secrets for staging/production
# Copy to .env.secrets and fill in real values
# NEVER commit .env.secrets to git
#
# For CD: these are generated from GitHub Secrets automatically.
# For local staging: copy this file and fill in values manually.

# Database password (used by Postgres container and to build DATABASE_URL)
POSTGRES_PASSWORD=
# Full connection URL (built from POSTGRES_PASSWORD: postgres://veziizi:<password>@postgres:5432/veziizi?sslmode=disable)
DATABASE_URL=

# Sessions (generate with: openssl rand -hex 16)
SESSION_SECRET=
SESSION_ADMIN_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=

# Email (Resend)
RESEND_API_KEY=
