# Dev environment config (safe to commit — no secrets)
# Used by: task dev:all, task up, goreman/air flow

APP_ENV=development
LOG_LEVEL=debug

# Database (local Docker Postgres)
POSTGRES_USER=veziizi
POSTGRES_PASSWORD=veziizi
POSTGRES_DB=veziizi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://veziizi:veziizi@localhost:5432/veziizi?sslmode=disable

# Redis (local Docker Redis) — транспорт событий (outbox -> forwarder -> streams)
REDIS_URL=redis://localhost:6379/0

# HTTP
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# Sessions (dev-only, NOT for production)
SESSION_SECRET=dev-secret-not-for-production!!
SESSION_ADMIN_SECRET=dev-admin-secret-not-for-prod!
SESSION_NAME=veziizi_session
SESSION_ADMIN_NAME=veziizi_admin_session
SESSION_MAX_AGE=86400

# Telegram (empty = disabled)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=veziizi_bot

# Email (disabled in dev)
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=noreply@veziizi.ru
EMAIL_FROM_NAME=Veziizi
RESEND_API_KEY=

# App
APP_BASE_URL=http://localhost:5173

# Metrics
METRICS_ENABLED=true
METRICS_ADDR=:9090
